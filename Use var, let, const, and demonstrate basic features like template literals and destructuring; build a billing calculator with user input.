
<!DOCTYPE html>
<html>
<head>
    <title>Billing Calculator</title>
</head>
<body>

<h2>Shopping Billing Calculator</h2>

<label>Product Name:</label>
<input type="text" id="product"><br><br>

<label>Price:</label>
<input type="number" id="price"><br><br>

<label>Quantity:</label>
<input type="number" id="quantity"><br><br>

<button onclick="calculateBill()">Generate Bill</button>

<h3 id="result"></h3>

<script>
function calculateBill() {

    // var variable
    var shopName = "ABC Shopping Store";

    // let variable
    let price = Number(document.getElementById("price").value);
    let quantity = Number(document.getElementById("quantity").value);

    // const variable
    const GST = 18;

    let product = document.getElementById("product").value;

    if (!product || price <= 0 || quantity <= 0) {
        alert("Please enter valid details!");
        return;
    }

    // Array destructuring
    let [p, q] = [price, quantity];

    let total = p * q;
    let tax = total * GST / 100;
    let finalAmount = total + tax;

    // Template literal
    document.getElementById("result").innerHTML = `
        Store: ${shopName}<br>
        Product: ${product}<br>
        Price: ₹${price}<br>
        Quantity: ${quantity}<br>
        Total: ₹${total.toFixed(2)}<br>
        GST (18%): ₹${tax.toFixed(2)}<br>
        <b>Final Bill: ₹${finalAmount.toFixed(2)}</b>
    `;
}
</script>

</body>
</html>
