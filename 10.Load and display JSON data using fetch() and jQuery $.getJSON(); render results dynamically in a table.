
<!DOCTYPE html>
<html>
<head>
    <title>JSON Data Display</title>

    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

</head>
<body>

<h2>Student Data Using Fetch API</h2>

<button onclick="loadFetch()">Load Using Fetch</button>

<button onclick="loadJQuery()">Load Using jQuery</button>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody id="tableData"></tbody>
</table>

<script>

// Fetch API
function loadFetch() {

    fetch("https://jsonplaceholder.typicode.com/users")
    .then(response => {
        if (!response.ok) {
            throw new Error("Network response failed");
        }
        return response.json();
    })
    .then(data => {

        displayData(data);

    })
    .catch(error => {
        alert("Error: " + error.message);
    });
}

// jQuery getJSON
function loadJQuery() {

    $.getJSON("https://jsonplaceholder.typicode.com/users",
    function(data) {

        displayData(data);

    }).fail(function() {

        alert("Unable to load JSON data!");

    });
}

// Display JSON data dynamically
function displayData(data) {

    let output = "";

    data.forEach(user => {

        output += `
            <tr>
                <td>${user.id}</td>
                <td>${user.name}</td>
                <td>${user.email}</td>
            </tr>
        `;

    });

    document.getElementById("tableData").innerHTML = output;
}

</script>

</body>
</html>
