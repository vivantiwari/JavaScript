
<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
</head>
<body>

<h2>Shopping Cart Calculator</h2>

<button onclick="calculateCart()">Calculate Total</button>

<div id="result"></div>

<script>

// Array of objects
let cart = [
    {name: "Laptop", price: 50000, quantity: 1},
    {name: "Mouse", price: 500, quantity: 2},
    {name: "Keyboard", price: 1000, quantity: 1},
    {name: "Headphones", price: 2000, quantity: 1}
];

function calculateCart() {

    // map() method
    let items = cart.map(item => {
        return {
            name: item.name,
            total: item.price * item.quantity
        };
    });

    // filter() method
    let expensive = items.filter(item => item.total >= 1000);

    // reduce() method
    let total = items.reduce((sum, item) =>
        sum + item.total, 0
    );

    // Discount logic
    let discount = 0;

    if (total >= 50000) {
        discount = total * 10 / 100;
    }
    else if (total >= 10000) {
        discount = total * 5 / 100;
    }

    let finalTotal = total - discount;

    let output = "<h3>Cart Items</h3>";

    cart.forEach(item => {
        output += `${item.name} - ₹${item.price}
        × ${item.quantity}<br>`;
    });

    output += `
        <hr>
        Subtotal: ₹${total}<br>
        Discount: ₹${discount}<br>
        <b>Final Total: ₹${finalTotal}</b>
        <br><br>
        Expensive Items: ${expensive.length}
    `;

    document.getElementById("result").innerHTML = output;

    console.log("Cart:", cart);
    console.log("Mapped Items:", items);
}

</script>

</body>
</html>
